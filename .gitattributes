# Normalize all text files to LF in the repository, regardless of platform.
# Files are auto-detected as text/binary, but text files are stored with LF.
* text=auto eol=lf

# Be explicit for the file types in this repo.
*.go        text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf
*.cs        text eol=lf
Dockerfile  text eol=lf

# Binary file types - never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
